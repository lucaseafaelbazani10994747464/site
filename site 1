                    </div>
                    <div class="product-info">
                        <span class="product-category">${product.category === 'jogador' ? 'Estilo Jogador' : 'Social'}</span>
                        <h3 class="product-title" onclick="openProductModal(${product.id})">${product.name}</h3>
                        <div class="product-prices">
                            <span class="price-current">R$ ${product.price.toFixed(2).replace('.', ',')}</span>
                            ${product.oldPrice ? `<span class="price-old">R$ ${product.oldPrice.toFixed(2).replace('.', ',')}</span>` : ''}
                        </div>
                        <div class="product-actions">
                            <button class="btn-cart" onclick="quickAddToCart(${product.id})">Adicionar</button>
                            <button class="btn-icon-only" onclick="openProductModal(${product.id})"><i class="fa-solid fa-eye"></i></button>
                        </div>
                    </div>
                </div>
            `;
        }

        // FILTRAGEM
        function filterCategory(cat, btnElement) {
            renderProducts(cat, 'productsGrid');
            if(btnElement) {
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btnElement.classList.add('active');
            }
            window.location.hash = '#destaque';
        }

        // MODAL DE PRODUTO DETALHADO
        let currentSelectedSize = null;

        function openProductModal(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;

            currentSelectedSize = product.sizes[0];

            const modalContent = document.getElementById('modalContent');
            modalContent.innerHTML = `
                <div class="product-detail-img">
                    <img src="${product.image}" alt="${product.name}">
                </div>
                <div class="product-detail-info">
                    <span class="product-category">${product.category === 'jogador' ? 'Calça Estilo Jogador' : 'Calça Social'}</span>
                    <h2>${product.name}</h2>
                    <div class="price-current">R$ ${product.price.toFixed(2).replace('.', ',')}</div>
                    <p>${product.description}</p>
                    
                    <label style="font-size:0.85rem; font-weight:700; margin-bottom:8px; display:block;">SELECIONE O TAMANHO:</label>
                    <div class="size-selector" id="modalSizeSelector">
                        ${product.sizes.map((s, index) => `<button class="size-btn ${index === 0 ? 'active' : ''}" onclick="selectSize('${s}', this)">${s}</button>`).join('')}
                    </div>

                    <label style="font-size:0.85rem; font-weight:700; margin-bottom:8px; display:block;">QUANTIDADE:</label>
                    <div class="quantity-selector">
                        <button onclick="decrementQty()">-</button>
                        <input type="text" id="modalQty" value="1" readonly>
                        <button onclick="incrementQty()">+</button>
                    </div>

                    <div class="detail-buttons">
                        <button class="btn" onclick="addToCartFromModal(${product.id})"><i class="fa-solid fa-bag-shopping"></i> Adicionar ao Carrinho</button>
                        <button class="btn btn-whatsapp-buy" onclick="buyViaWhatsApp(${product.id})"><i class="fa-brands fa-whatsapp"></i> Comprar pelo WhatsApp</button>
                    </div>

                    <!-- Detalhes Accordion -->
                    <div class="accordion-item active" onclick="toggleAccordion(this)">
                        <div class="accordion-header">Detalhes do Tecido & Modelagem <i class="fa-solid fa-chevron-down"></i></div>
                        <div class="accordion-content">
                            • Tecido: ${product.fabric}<br>
                            • Modelagem: ${product.modelagem}<br>
                            • Caimento: ${product.caimento}
                        </div>
                    </div>
                    <div class="accordion-item" onclick="toggleAccordion(this)">
                        <div class="accordion-header">Cuidados com a Peça <i class="fa-solid fa-chevron-down"></i></div>
                        <div class="accordion-content">${product.cuidados}</div>
                    </div>
                    <div class="accordion-item" onclick="toggleAccordion(this)">
                        <div class="accordion-header">Envio e Trocas <i class="fa-solid fa-chevron-down"></i></div>
                        <div class="accordion-content">Enviamos para todo o Brasil. Trocas gratuitas garantidas em até 7 dias após o recebimento.</div>
                    </div>
                </div>
            `;

            document.getElementById('productModal').classList.add('active');
        }

        function closeModal() {
            document.getElementById('productModal').classList.remove('active');
        }

        function selectSize(size, btn) {
            currentSelectedSize = size;
            document.querySelectorAll('#modalSizeSelector .size-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        function incrementQty() {
            const input = document.getElementById('modalQty');
            input.value = parseInt(input.value) + 1;
        }

        function decrementQty() {
            const input = document.getElementById('modalQty');
            if (parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
            }
        }

        function toggleAccordion(item) {
            item.classList.toggle('active');
        }

        // CARRINHO LOGIC
        function quickAddToCart(productId) {
            const product = products.find(p => p.id === productId);
            if (!product) return;
            addToCart(product, product.sizes[0], 1);
        }

        function addToCartFromModal(productId) {
            const product = products.find(p => p.id === productId);
            const qty = parseInt(document.getElementById('modalQty').value);
            addToCart(product, currentSelectedSize, qty);
            closeModal();
            toggleCart();
        }

        function addToCart(product, size, qty) {
            const existing = cart.find(item => item.id === product.id && item.size === size);
            if (existing) {
                existing.qty += qty;
            } else {
                cart.push({
                    id: product.id,
                    name: product.name,
                    price: product.price,
                    image: product.image,
                    size: size,
                    qty: qty
                });
            }
            updateCartUI();
        }

        function updateCartUI() {
            const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('cartCount').innerText = totalCount;
            document.getElementById('cartDrawerCount').innerText = totalCount;

            const list = document.getElementById('cartItemsList');
            if (cart.length === 0) {
                list.innerHTML = `<p style="text-align:center; color: var(--text-secondary); margin-top: 40px;">Seu carrinho está vazio.</p>`;
                document.getElementById('cartTotalPrice').innerText = 'R$ 0,00';
                return;
            }

            let total = 0;
            list.innerHTML = cart.map((item, index) => {
                const itemTotal = item.price * item.qty;
                total += itemTotal;
                return `
                    <div class="cart-item">
                        <img src="${item.image}" alt="${item.name}">
                        <div class="cart-item-info" style="flex-grow:1;">
                            <h4>${item.name}</h4>
                            <p>Tamanho: ${item.size} | Qtd: ${item.qty}</p>
                            <strong>R$ ${itemTotal.toFixed(2).replace('.', ',')}</strong>
                        </div>
                        <button onclick="removeFromCart(${index})" style="background:none; border:none; color:var(--text-secondary); cursor:pointer;"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `;
            }).join('');

            document.getElementById('cartTotalPrice').innerText = `R$ ${total.toFixed(2).replace('.', ',')}`;
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartUI();
        }

        function toggleCart() {
            document.getElementById('cartDrawer').classList.toggle('active');
        }

        // WHATSAPP COMPRIMENTO & CHECKOUT
        function buyViaWhatsApp(productId) {
            const product = products.find(p => p.id === productId);
            const qty = document.getElementById('modalQty') ? document.getElementById('modalQty').value : 1;
            const message = `Olá! Gostaria de comprar o produto *${product.name}* (Tamanho: ${currentSelectedSize}, Quantidade: ${qty}) por R$ ${(product.price * qty).toFixed(2).replace('.', ',')}. Como procedemos com o pagamento e envio?`;
            window.open(`https://wa.me/5541995776196?text=${encodeURIComponent(message)}`, '_blank');
        }

        function checkoutWhatsApp() {
            if (cart.length === 0) {
                alert('Seu carrinho está vazio!');
                return;
            }
            let message = "Olá! Gostaria de finalizar o meu pedido na Jogador Store:\n\n";
            let total = 0;
            cart.forEach(item => {
                const sub = item.price * item.qty;
                total += sub;
                message += `• ${item.qty}x ${item.name} (Tam: ${item.size}) - R$ ${sub.toFixed(2).replace('.', ',')}\n`;
            });
            message += `\n*Total do Pedido: R$ ${total.toFixed(2).replace('.', ',')}*\n\nPor favor, me informe os dados para pagamento e o cálculo do frete para meu endereço.`;
            window.open(`https://wa.me/5541995776196?text=${encodeURIComponent(message)}`, '_blank');
        }

        // FAVORITOS
        function toggleFavorite(productId) {
            const idx = favorites.indexOf(productId);
            if (idx > -1) {
                favorites.splice(idx, 1);
            } else {
                favorites.push(productId);
            }
            renderProducts(document.querySelector('.filter-btn.active')?.textContent.includes('Jogador') ? 'jogador' : 'all');
            renderSpecialSections();
        }

        function toggleFavorites() {
            if(favorites.length === 0) {
                alert('Você ainda não adicionou produtos aos favoritos.');
                return;
            }
            filterCategory('all');
            alert(`Você tem ${favorites.length} produto(s) favorito(s).`);
        }

        function openSearch() {
            const query = prompt('O que você está procurando na Jogador Store? (Ex: Jogador Black, Social...)');
            if (query) {
                const found = products.filter(p => p.name.toLowerCase().includes(query.toLowerCase()));
                if(found.length > 0) {
                    const grid = document.getElementById('productsGrid');
                    grid.innerHTML = found.map(product => createProductCardHTML(product)).join('');
                    window.location.hash = '#destaque';
                } else {
                    alert('Nenhum produto encontrado com esse termo.');
                }
            }
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('navMenu');
            menu.classList.toggle('active');
            const icon = document.getElementById('menuIcon');
            icon.classList.toggle('fa-bars');
            icon.classList.toggle('fa-xmark');
        }

        // INICIALIZAÇÃO
        window.addEventListener('DOMContentLoaded', () => {
            renderProducts('all', 'productsGrid');
            renderSpecialSections();
        });
    </script>
</body>
</html>
