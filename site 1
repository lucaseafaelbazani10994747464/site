<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JOGADOR STORE | Seu Estilo. Suas Regras.</title>
    <!-- Google Fonts: Montserrat & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">
    <!-- FontAwesome para ícones -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-primary: #0a0a0a;
            --bg-secondary: #121212;
            --bg-card: #181818;
            --bg-card-hover: #222222;
            --text-primary: #ffffff;
            --text-secondary: #a1a1a6;
            --accent: #39ff14; /* Verde-limão moderno */
            --accent-hover: #32e011;
            --border-color: #2a2a2a;
            --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3, h4, h5, h6, .brand-font {
            font-family: 'Montserrat', sans-serif;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* BARRA DE NAVEGAÇÃO */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background: rgba(10, 10, 10, 0.95);
            backdrop-filter: blur(10px);
            z-index: 1000;
            border-bottom: 1px solid var(--border-color);
        }

        .nav-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 80px;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 900;
            letter-spacing: 2px;
            color: var(--text-primary);
        }

        .logo span {
            color: var(--accent);
        }

        .nav-menu {
            display: flex;
            gap: 24px;
        }

        .nav-menu a {
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--text-secondary);
            transition: var(--transition);
        }

        .nav-menu a:hover, .nav-menu a.active {
            color: var(--accent);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .nav-actions button {
            background: none;
            border: none;
            color: var(--text-primary);
            font-size: 1.1rem;
            cursor: pointer;
            position: relative;
            transition: var(--transition);
        }

        .nav-actions button:hover {
            color: var(--accent);
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -10px;
            background: var(--accent);
            color: #000;
            font-size: 0.65rem;
            font-weight: 800;
            padding: 2px 5px;
            border-radius: 50%;
        }

        .mobile-toggle {
            display: none;
            font-size: 1.5rem;
            background: none;
            border: none;
            color: var(--text-primary);
            cursor: pointer;
        }

        /* BANNER PRINCIPAL */
        .hero {
            position: relative;
            height: 90vh;
            margin-top: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            overflow: hidden;
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.8)), url('https://images.unsplash.com/photo-1516257984-b1b4d707412e?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        }

        .hero-content {
            max-width: 900px;
            padding: 0 20px;
            z-index: 2;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            font-weight: 900;
            margin-bottom: 15px;
            letter-spacing: 2px;
        }

        .hero p {
            font-size: clamp(1rem, 2vw, 1.25rem);
            color: var(--text-secondary);
            margin-bottom: 35px;
        }

        .hero-split {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 30px;
        }

        .hero-card-split {
            background: rgba(18, 18, 18, 0.7);
            border: 1px solid var(--border-color);
            padding: 25px;
            border-radius: 8px;
            backdrop-filter: blur(5px);
            text-align: left;
            transition: var(--transition);
        }

        .hero-card-split:hover {
            border-color: var(--accent);
        }

        .hero-card-split h3 {
            font-size: 1.1rem;
            margin-bottom: 8px;
            color: var(--accent);
        }

        .hero-card-split p {
            font-size: 0.9rem;
            margin-bottom: 15px;
            color: var(--text-secondary);
        }

        /* BOTÕES */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: var(--accent);
            color: #000;
            font-weight: 700;
            padding: 12px 24px;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1px;
            transition: var(--transition);
        }

        .btn:hover {
            background: var(--accent-hover);
            transform: translateY(-2px);
        }

        .btn-outline {
            background: transparent;
            color: var(--text-primary);
            border: 1px solid var(--text-primary);
        }

        .btn-outline:hover {
            background: var(--text-primary);
            color: #000;
        }

        /* SEÇÃO DE DESTAQUE & UNIVERSOS */
        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-header h2 {
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .section-header p {
            color: var(--text-secondary);
            font-size: 1rem;
        }

        .universe-section {
            padding: 100px 0;
            background: var(--bg-secondary);
        }

        .universe-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .universe-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            min-height: 450px;
            padding: 40px;
        }

        .universe-card.jogador {
            background: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.9)), url('https://images.unsplash.com/photo-1509631179647-0177331693ae?auto=format&fit=crop&w=800&q=80') center/cover;
        }

        .universe-card.social {
            background: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.9)), url('https://images.unsplash.com/photo-1490114838074-c3942978d65e?auto=format&fit=crop&w=800&q=80') center/cover;
        }

        .universe-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent);
        }

        .universe-content h3 {
            font-size: 1.8rem;
            margin-bottom: 10px;
            color: var(--text-primary);
        }

        .universe-content p {
            color: var(--text-secondary);
            margin-bottom: 20px;
            font-size: 0.95rem;
        }

        /* DIFERENCIAL / COMPARATIVO */
        .contrast-section {
            padding: 80px 0;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
        }

        .contrast-grid {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 30px;
            align-items: center;
            text-align: center;
        }

        .contrast-box h3 {
            font-size: 1.5rem;
            margin-bottom: 15px;
            color: var(--accent);
        }

        .contrast-box ul {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
            color: var(--text-secondary);
            font-size: 0.9rem;
            font-weight: 500;
        }

        .contrast-box ul li {
            background: var(--bg-card);
            padding: 8px 15px;
            border-radius: 20px;
            border: 1px solid var(--border-color);
        }

        .contrast-vs {
            font-family: 'Montserrat', sans-serif;
            font-size: 2rem;
            font-weight: 900;
            color: var(--border-color);
        }

        /* PRODUTOS / NOVIDADES / OFERTAS */
        .products-section {
            padding: 100px 0;
        }

        .filter-buttons {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 8px 20px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            transition: var(--transition);
        }

        .filter-btn.active, .filter-btn:hover {
            background: var(--accent);
            color: #000;
            border-color: var(--accent);
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
        }

        .product-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            overflow: hidden;
            transition: var(--transition);
            position: relative;
            display: flex;
            flex-direction: column;
        }

        .product-card:hover {
            border-color: var(--accent);
            transform: translateY(-5px);
        }

        .product-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            background: var(--accent);
            color: #000;
            font-size: 0.7rem;
            font-weight: 800;
            padding: 4px 10px;
            border-radius: 4px;
            z-index: 2;
        }

        .product-badge.sale {
            background: #ff3b30;
            color: #fff;
        }

        .product-fav {
            position: absolute;
            top: 12px;
            right: 12px;
            background: rgba(0,0,0,0.6);
            border: none;
            color: var(--text-primary);
            width: 35px;
            height: 35px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2;
            transition: var(--transition);
        }

        .product-fav:hover, .product-fav.active {
            color: #ff3b30;
            background: #fff;
        }

        .product-img-wrapper {
            position: relative;
            height: 320px;
            overflow: hidden;
            background: #1e1e1e;
            cursor: pointer;
        }

        .product-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: var(--transition);
        }

        .product-card:hover .product-img-wrapper img {
            transform: scale(1.05);
        }

        .product-info {
            padding: 20px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .product-category {
            font-size: 0.75rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            margin-bottom: 6px;
            letter-spacing: 1px;
        }

        .product-title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 10px;
            cursor: pointer;
            transition: var(--transition);
        }

        .product-title:hover {
            color: var(--accent);
        }

        .product-sizes {
            display: flex;
            gap: 6px;
            margin-bottom: 15px;
        }

        .size-dot {
            font-size: 0.7rem;
            border: 1px solid var(--border-color);
            padding: 3px 8px;
            border-radius: 4px;
            color: var(--text-secondary);
        }

        .product-prices {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: auto;
            margin-bottom: 15px;
        }

        .price-current {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--text-primary);
        }

        .price-old {
            font-size: 0.9rem;
            color: var(--text-secondary);
            text-decoration: line-through;
        }

        .discount-tag {
            font-size: 0.75rem;
            color: var(--accent);
            font-weight: 700;
        }

        .product-actions {
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 10px;
        }

        .btn-cart {
            background: var(--text-primary);
            color: #000;
            border: none;
            padding: 10px;
            border-radius: 4px;
            font-weight: 700;
            font-size: 0.8rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .btn-cart:hover {
            background: var(--accent);
        }

        .btn-icon-only {
            background: var(--bg-card-hover);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            width: 40px;
            border-radius: 4px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .btn-icon-only:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        /* SEÇÃO INTERATIVA: ENCONTRE SEU ESTILO */
        .interactive-style {
            padding: 80px 0;
            background: var(--bg-secondary);
        }

        .style-chooser-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        .style-option-card {
            background: var(--bg-card);
            border: 2px solid var(--border-color);
            border-radius: 12px;
            padding: 50px 40px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .style-option-card:hover {
            border-color: var(--accent);
            background: var(--bg-card-hover);
            transform: translateY(-5px);
        }

        .style-option-card h3 {
            font-size: 2rem;
            margin-bottom: 15px;
            color: var(--text-primary);
        }

        .style-option-card p {
            color: var(--text-secondary);
            font-size: 1.05rem;
        }

        /* SEÇÃO DE CONFIANÇA */
        .trust-section {
            padding: 80px 0;
            background: var(--bg-primary);
            border-top: 1px solid var(--border-color);
        }

        .trust-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 30px;
        }

        .trust-item {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            padding: 20px;
            background: var(--bg-card);
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }

        .trust-item i {
            font-size: 2rem;
            color: var(--accent);
        }

        .trust-item h4 {
            font-size: 0.95rem;
            margin-bottom: 5px;
        }

        .trust-item p {
            font-size: 0.85rem;
            color: var(--text-secondary);
        }

        /* SOBRE NÓS */
        .about-section {
            padding: 100px 0;
            background: var(--bg-secondary);
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .about-text h2 {
            font-size: 2.5rem;
            font-weight: 900;
            margin-bottom: 20px;
            line-height: 1.2;
        }

        .about-text p {
            color: var(--text-secondary);
            font-size: 1.05rem;
            line-height: 1.7;
            margin-bottom: 25px;
        }

        .about-img {
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-color);
            height: 450px;
        }

        .about-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* NEWSLETTER WHATSAPP */
        .whatsapp-cta {
            padding: 80px 0;
            background: linear-gradient(135deg, #121212 0%, #1a2e19 100%);
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            text-align: center;
        }

        .whatsapp-cta-content {
            max-width: 700px;
            margin: 0 auto;
        }

        .whatsapp-cta h2 {
            font-size: 2.2rem;
            margin-bottom: 15px;
        }

        .whatsapp-cta p {
            color: var(--text-secondary);
            margin-bottom: 30px;
            font-size: 1.05rem;
        }

        /* RODAPÉ */
        footer {
            background: #050505;
            padding: 80px 0 30px;
            border-top: 1px solid var(--border-color);
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 40px;
            margin-bottom: 60px;
        }

        .footer-col h3 {
            font-size: 1.1rem;
            margin-bottom: 20px;
            color: var(--text-primary);
        }

        .footer-col p {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .footer-col ul li {
            margin-bottom: 10px;
        }

        .footer-col ul li a {
            color: var(--text-secondary);
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .footer-col ul li a:hover {
            color: var(--accent);
        }

        .footer-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 30px;
            border-top: 1px solid var(--border-color);
            color: var(--text-secondary);
            font-size: 0.85rem;
        }

        /* BOTÃO FLUTUANTE WHATSAPP */
        .whatsapp-float {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: #25d366;
            color: #fff;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4);
            z-index: 999;
            transition: var(--transition);
        }

        .whatsapp-float:hover {
            transform: scale(1.1);
            background: #20ba5a;
        }

        /* MODAL / PÁGINA DE DETALHES DO PRODUTO */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.85);
            backdrop-filter: blur(8px);
            z-index: 2000;
            display: none;
            justify-content: center;
            align-items: center;
            padding: 20px;
            overflow-y: auto;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-container {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            width: 100%;
            max-width: 1000px;
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            max-height: 90vh;
            display: flex;
            flex-direction: column;
        }

        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            cursor: pointer;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            transition: var(--transition);
        }

        .modal-close:hover {
            background: var(--accent);
            color: #000;
        }

        .product-detail-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            overflow-y: auto;
        }

        .product-detail-img {
            background: #1a1a1a;
            padding: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-detail-img img {
            width: 100%;
            max-height: 450px;
            object-fit: cover;
            border-radius: 8px;
        }

        .product-detail-info {
            padding: 40px;
            display: flex;
            flex-direction: column;
        }

        .product-detail-info h2 {
            font-size: 1.8rem;
            margin-bottom: 10px;
        }

        .product-detail-info .price-current {
            font-size: 1.6rem;
            margin: 15px 0;
        }

        .product-detail-info p {
            color: var(--text-secondary);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .size-selector {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .size-btn {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            width: 45px;
            height: 45px;
            border-radius: 6px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
        }

        .size-btn.active, .size-btn:hover {
            border-color: var(--accent);
            background: var(--accent);
            color: #000;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            border: 1px solid var(--border-color);
            width: 120px;
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 25px;
        }

        .quantity-selector button {
            background: var(--bg-card);
            border: none;
            color: var(--text-primary);
            width: 40px;
            height: 45px;
            cursor: pointer;
            font-size: 1rem;
        }

        .quantity-selector input {
            width: 40px;
            height: 45px;
            background: transparent;
            border: none;
            color: var(--text-primary);
            text-align: center;
            font-weight: 700;
        }

        .detail-buttons {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 30px;
        }

        .btn-whatsapp-buy {
            background: #25d366;
            color: #fff;
            border: none;
        }
        .btn-whatsapp-buy:hover {
            background: #20ba5a;
        }

        .accordion-item {
            border-top: 1px solid var(--border-color);
            padding: 15px 0;
        }

        .accordion-header {
            display: flex;
            justify-content: space-between;
